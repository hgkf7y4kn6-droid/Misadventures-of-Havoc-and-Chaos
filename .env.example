# The Misadventures of Havoc and Chaos — example configuration.
# Every setting is optional: with nothing set, the game runs fully offline using its
# built-in procedural narrator, SQLite, in-process realtime, and browser narration.

# --- Storage / realtime -----------------------------------------------------------
# HAVOC_DATABASE_URL=postgresql+asyncpg://havoc:havoc@localhost:5432/havoc
# HAVOC_REDIS_URL=redis://localhost:6379/0

# --- LLM narrator: offline | anthropic | openai -----------------------------------------
HAVOC_LLM_PROVIDER=offline
# HAVOC_LLM_PROVIDER=anthropic
# HAVOC_LLM_API_KEY=sk-ant-...          # or leave unset to use the SDK's normal credential chain
# HAVOC_LLM_MODEL=claude-opus-5-5       # default for the anthropic provider
# HAVOC_LLM_PROVIDER=openai             # any OpenAI-compatible chat-completions endpoint
# HAVOC_LLM_BASE_URL=https://api.openai.com/v1
# HAVOC_LLM_MODEL=your-model-name

# --- Read-aloud narration: browser | openai | elevenlabs | google | polly -------------------
HAVOC_TTS_PROVIDER=browser
# HAVOC_TTS_API_KEY=...
# HAVOC_ELEVENLABS_VOICES={"comedic": "<voice id>", "deadpan": "<voice id>"}
# (polly uses the standard AWS credential chain; pip install boto3)

# --- Game defaults (hosts can change most of these per lobby) -------------------------------
# HAVOC_MIN_PLAYERS=2
# HAVOC_MAX_PLAYERS_LIMIT=12
# HAVOC_DEFAULT_MAX_PLAYERS=8
# HAVOC_DECISION_SECONDS=120
# HAVOC_THEME_SUBMISSION_SECONDS=90
# HAVOC_THEME_VOTING_SECONDS=60
# HAVOC_CHARACTER_CREATION_SECONDS=180
# Final story word targets (min,max) per adventure length
# HAVOC_STORY_WORDS_SHORT=[1000,2000]
# HAVOC_STORY_WORDS_MEDIUM=[2000,4000]
# HAVOC_STORY_WORDS_LONG=[4000,7000]

# --- Identity ------------------------------------------------------------------------------
# HAVOC_SESSION_SECRET=change-me                     # signs guest sessions + socket tickets
# HAVOC_CLERK_JWT_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# HAVOC_CLERK_JWKS_URL=https://<your-clerk-domain>/.well-known/jwks.json
# HAVOC_CLERK_AUTHORIZED_PARTIES=["https://play.example.com"]

# --- Analytics -----------------------------------------------------------------------------
# HAVOC_POSTHOG_API_KEY=phc_...
# HAVOC_POSTHOG_HOST=https://us.i.posthog.com

# --- Cloudflare edge mode (engine behind the GameRoom Durable Object) ------------------------
# HAVOC_EDGE_SECRET=shared-with-the-worker
# HAVOC_EDGE_URL=https://play.example.com
