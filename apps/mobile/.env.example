# Copy to .env.local for `expo start`. In EAS builds set these with `eas env:create` or eas.json.
EXPO_PUBLIC_API_URL=http://localhost:8787        # the edge Worker (or the standalone engine on :8000)
# EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...  # optional: sign-in; guests work without it
# EXPO_PUBLIC_POSTHOG_KEY=phc_...                # optional: product analytics
# EXPO_PUBLIC_POSTHOG_HOST=http://localhost:8787/ingest
